ENVIRONMENT=production
PORT=8000

# The configured default is preferred. If its key is absent, LawShield now uses
# another provider which has a key.
DEFAULT_LLM_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Optional but strongly recommended when EC2 is internet-accessible. Use the
# same value in Render's AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=https://lawshield.vercel.app,https://lawshield-backend.onrender.com

# Install with: python -m spacy download en_core_web_sm
# Chat still works with regex PII protection if this model is not installed.
SPACY_MODEL=en_core_web_sm

# Keep disabled for a fast/reliable demo. Enable after Qdrant and the embedding
# model have been provisioned and warmed.
ENABLE_VECTOR_MEMORY=false
ENABLE_LONG_TERM_MEMORY=false

DATABASE_URL=
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200
