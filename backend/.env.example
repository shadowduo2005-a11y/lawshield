NODE_ENV=production
PORT=3000

# Neon: use the hostname containing "-pooler" for runtime traffic.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/neondb?sslmode=require
# Neon: use the non-pooler hostname for Prisma schema deployment.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-long-random-secret

# No trailing slash. Replace this placeholder with the EC2 Elastic IP/domain.
AI_SERVICE_URL=http://EC2_PUBLIC_IPV4_ADDRESS:8000
AI_SERVICE_TOKEN=replace-with-the-same-random-token-used-on-ec2
AI_REQUEST_TIMEOUT_MS=180000

FRONTEND_URL=https://lawshield.vercel.app
ALLOW_VERCEL_PREVIEWS=false
